#!/usr/bin/env python

import sys, os
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import *
from save_utils import save_results

from math import exp

# Exact expressions for partition function, occupation numbers and Green function
# cf. Eq. (B.3) and (B.4) of S. Pairault, et al., EPJ B 16, 85-105 (2000)

Z = 1. + exp((mu+h)*beta) + exp((mu-h)*beta) + exp((2.*mu-U)*beta)

density = {}
density['up'] = ( exp((mu+h)*beta) + exp((2.*mu-U)*beta) ) / Z
density['dn'] = ( exp((mu-h)*beta) + exp((2.*mu-U)*beta) ) / Z

G_iw = BlockGf(mesh=iw_mesh, gf_struct=gf_struct)

G_iw['up'] = Gf(mesh=iw_mesh, target_shape=(1,1))
G_iw['dn'] = Gf(mesh=iw_mesh, target_shape=(1,1))

G_iw['up'] << ( 1 - density['dn'] ) * inverse( iOmega_n + mu + h ) + \
                    density['dn']   * inverse( iOmega_n + mu + h  - U )
G_iw['dn'] << ( 1 - density['up'] ) * inverse( iOmega_n + mu - h ) + \
                    density['up']   * inverse( iOmega_n + mu - h  - U )

# --------- Collect observables ----------
nn_ab = {
    'up,dn': exp((2.*mu-U)*beta) / Z,
    'dn,up': exp((2.*mu-U)*beta) / Z,
    'up,up': density['up'],
    'dn,dn': density['dn'],
}
obs = {
    'G': G_iw,
    'static_obs': {'density': density, 'nn_ab': nn_ab},
}

# --------- Save ----------
save_results("../results/exact.h5", "exact", "N/A", "N/A", **obs)
