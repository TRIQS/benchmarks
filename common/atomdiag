#!/usr/bin/env python

import sys, os
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import *
from itertools import product
import util
from save_utils import save_results, parse_measure_args

from triqs.utility import mpi
from triqs.atom_diag import *
from triqs import version

# --------- Parse arguments ----------
SUPPORTED = []
args = parse_measure_args(SUPPORTED)

# --------- Construct the AtomDiag Object ----------

fop_imp  = [(s,o) for s, n in gf_struct for o in range(n)]
fop_bath = [(s,o) for s, o in product(block_names, range(n_orb, n_orb + n_orb_bath))]
fop_tot  = fop_imp + fop_bath

ad_tot = AtomDiag(h_tot, fop_tot)

# --------- Calculate the single-particle Green function ----------

gf_struct_tot = [[s, n_orb + n_orb_bath] for s in block_names]
G_iw_tot = atomic_g_iw(ad_tot, beta, gf_struct_tot, n_iw)

name_list = [bl for bl, n_orb in gf_struct]
block_list = [G_iw_tot[bl][:n_orb, :n_orb] for bl, n_orb in gf_struct]
G_iw = BlockGf(name_list=name_list, block_list=block_list)

# --------- Collect observables ----------
obs = {'G': G_iw}

# Static observables via trace_rho_op
rho = atomic_density_matrix(ad_tot, beta)
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = trace_rho_op(rho, n(bl, i), ad_tot)
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = trace_rho_op(rho, n(bl, i) * n(bl2, j), ad_tot)
obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# --------- Save ----------
save_results("../results/atomdiag.h5", "atomdiag", version.version,
             version.git_hash, **obs)
