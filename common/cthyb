#!/usr/bin/env python
# Solver: CT-HYB (triqs_cthyb) -- hybridization expansion
# Requires: non-zero Delta(iw); supports Jperp via delta_interface

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import beta, gf_struct, n_iw, G0_iw, h_int
from save_utils import save_results, parse_measure_args

from triqs.utility import mpi
from triqs.gf import iOmega_n, inverse
from triqs.operators import c, c_dag, n
from triqs_cthyb import Solver, version
import numpy as np

# --------- Parse arguments ----------
SUPPORTED = ['chi4']
args = parse_measure_args(SUPPORTED)

# --------- Auto-detect dynamic interactions from model.py ----------
try:
    from model import Jperp_func
    has_Jperp = True
except ImportError:
    has_Jperp = False

n_tau_bosonic = 2001

# --------- Construct the CTHYB solver ----------
constr_params = {
        'beta' : beta,
        'gf_struct' : gf_struct,
        'n_iw' : n_iw,
        'n_tau' : 10001
        }

if has_Jperp:
    constr_params['delta_interface'] = True

S = Solver(**constr_params)

# --------- Initialize G0_iw / Delta_tau ----------
if has_Jperp:
    from triqs.gf import fit_hermitian_tail, Fourier, GfImFreq, GfImTime
    from triqs.operators import Operator

    # Decompose G0_iw into Delta_iw + h_loc0
    Delta_iw = G0_iw.copy()
    h0_matrices = {}
    for bl in G0_iw.indices:
        Delta_iw[bl] << iOmega_n - inverse(G0_iw[bl])
        tail, err = fit_hermitian_tail(Delta_iw[bl])
        h0_matrices[bl] = tail[0]
        Delta_iw[bl] << Delta_iw[bl] - tail[0]

    S.Delta_tau << Fourier(Delta_iw)

    # Build h_loc0 operator from h_0 matrices
    h_loc0 = Operator()
    for bl, bl_size in gf_struct:
        h0 = h0_matrices[bl]
        for i in range(bl_size):
            for j in range(bl_size):
                val = h0[i, j].real if np.ndim(h0) > 0 else float(h0.real)
                if abs(val) > 1e-10:
                    h_loc0 += val * c_dag(bl, i) * c(bl, j)

    # Set up Jperp_tau
    jperp_iw = GfImFreq(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic // 2)
    jperp_iw << Jperp_func
    jperp_tau = GfImTime(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic)
    jperp_tau << Fourier(jperp_iw)
    S.Jperp_tau << jperp_tau
else:
    S.G0_iw << G0_iw

# --------- Solve! ----------
solve_params = {
        'h_int' : h_int,
        'n_warmup_cycles' : 10000,
        'n_cycles' : args.n_cycles,
        'length_cycle' : 100,
        'measure_pert_order' : True,
        'measure_density_matrix' : True,
        'use_norm_as_weight' : True,
        }

if has_Jperp:
    solve_params['h_loc0'] = h_loc0

if 'chi4' in args.measure:
    solve_params['measure_G2_iw_ph'] = True
    solve_params['measure_G2_iw_pp'] = True
    solve_params['measure_G2_n_bosonic'] = 30
    solve_params['measure_G2_n_fermionic'] = 30
    solve_params['measure_G2_blocks'] = set([("up", "up"), ("up", "dn")])
    solve_params['measure_G2_block_order'] = 'block_order::AABB'

start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

hist = S.perturbation_order_total.data
average_k = 1.0 * np.sum(hist * np.arange(hist.shape[0])) / np.sum(hist)
if mpi.is_master_node(): print("Average perturbation order:", average_k)

# --------- Collect observables ----------
obs = {'G': S.G_iw_raw}

# Static observables from density matrix
from triqs.atom_diag import trace_rho_op
rho = S.density_matrix
h_loc_diag = S.h_loc_diagonalization
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = trace_rho_op(rho, n(bl, i), h_loc_diag)
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = trace_rho_op(rho, n(bl, i) * n(bl2, j), h_loc_diag)

obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# chi4/G2 measurement
if 'chi4' in args.measure:
    from channels import to_physical_channels_ph, to_physical_channels_pp
    import numpy as np
    chi4_d, chi4_m = to_physical_channels_ph(S.G2_iw_ph[('up', 'up')], S.G2_iw_ph[('up', 'dn')])
    # PP channels: cthyb measures AABB only. The ABBA crossed version is:
    # chi4_udc[i,j,k,l] = -chi4_ud[i,l,k,j] (anticommutation of annihilation pair)
    chi4_ud = S.G2_iw_pp[('up', 'dn')]
    chi4_udc = chi4_ud.copy()
    chi4_udc.data[...] = -np.swapaxes(chi4_ud.data, -3, -1)
    chi4_s, chi4_t = to_physical_channels_pp(chi4_ud, chi4_udc)
    obs.update(chi4_d=chi4_d, chi4_m=chi4_m, chi4_s=chi4_s, chi4_t=chi4_t)

# --------- Save ----------
save_results("../results/cthyb.h5", "triqs_cthyb", version.version,
             version.triqs_cthyb_hash,
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, **obs)
