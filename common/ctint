#!/usr/bin/env python
# Solver: CT-INT (triqs_ctint) -- interaction expansion
# Requires: G0_dlr_iw; auto-detects D0_func, Jperp_func

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import beta, gf_struct, n_iw, dlr_wmax, G0_dlr_iw, h_int
from save_utils import save_results, parse_measure_args

from triqs.gf import make_gf_dlr, make_gf_imfreq
from triqs_ctint import Solver, version

# --------- Parse arguments ----------
SUPPORTED = ['chi2', 'chi3']
args = parse_measure_args(SUPPORTED)

# --------- Auto-detect dynamic interactions from model.py ----------
try:
    from model import D0_func, D0_block_pairs
    has_D0 = True
except ImportError:
    has_D0 = False
try:
    from model import Jperp_func
    has_Jperp = True
except ImportError:
    has_Jperp = False

# --------- Construct the CTINT solver ----------
constr_params = {
        'beta' : beta,
        'gf_struct' : gf_struct,
        'dlr_wmax' : dlr_wmax,
        'dlr_eps' : G0_dlr_iw.mesh.eps,
        'n_tau' : 10001
        }

if has_D0:
    constr_params['use_D'] = True
    constr_params['n_tau_dynamical_interactions'] = 2000
if has_Jperp:
    constr_params['use_Jperp'] = True
    constr_params['n_tau_dynamical_interactions'] = 2000

S = Solver(**constr_params)

# --------- Initialize G0_iw ----------
S.G0_iw << G0_dlr_iw

# --------- Fill dynamic interactions ----------
if has_D0:
    for b1, b2 in D0_block_pairs:
        S.D0_iw[b1, b2][0, 0] << D0_func
if has_Jperp:
    S.Jperp_iw[0, 0] << Jperp_func

# --------- Solve! ----------
solve_params = {
        'h_int' : h_int,
        'n_cycles' : args.n_cycles,
        'measure_density' : True,
        }

if 'chi2' in args.measure:
    solve_params['measure_chi2pp_tau'] = True
    solve_params['measure_chi2ph_tau'] = True

if 'chi3' in args.measure:
    solve_params['measure_M3pp_iw'] = True
    solve_params['measure_M3ph_iw'] = True

start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

# --------- Collect observables ----------
obs = {'G': make_gf_imfreq(make_gf_dlr(S.G_iw), n_iw)}

# Static observables
density = {}
for bl_idx, (bl, bl_size) in enumerate(gf_struct):
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = S.density[bl_idx][i]
obs['static_obs'] = {'density': density}

# chi2 measurement (DLR -> ImFreq conversion)
if 'chi2' in args.measure:
    from channels import to_physical_channels_ph
    import util
    chi2_d, chi2_m = to_physical_channels_ph(S.chi2ph_iw[('up', 'up')], S.chi2ph_iw[('up', 'dn')])
    chi2_d = util.contract_chi2_density(make_gf_imfreq(make_gf_dlr(chi2_d), n_iw))
    chi2_m = util.contract_chi2_density(make_gf_imfreq(make_gf_dlr(chi2_m), n_iw))
    # PP: ctint provides AABB block ordering only. For density-contracted chi2,
    # chi2pp_udc = -chi2pp_ud (anticommutation of annihilation pair), so:
    #   chi2_s = chi2pp_ud - chi2pp_udc = 2 * chi2pp_ud
    #   chi2_t = chi2pp_ud + chi2pp_udc = 0
    chi2pp_ud = util.contract_chi2_density(make_gf_imfreq(make_gf_dlr(S.chi2pp_iw[('up', 'dn')]), n_iw))
    chi2_s = chi2pp_ud.copy()
    chi2_s *= 2.0
    chi2_t = chi2pp_ud.copy()
    chi2_t *= 0.0
    obs.update(chi2_d=chi2_d, chi2_m=chi2_m, chi2_s=chi2_s, chi2_t=chi2_t)

# chi3 measurement — evaluate DLR2D on (Boson, Fermion) channel mesh
if 'chi3' in args.measure:
    from triqs.gf import make_gf_dlr2d, MeshImFreq, MeshProduct
    from channels import to_physical_channels_ph, to_physical_channels_pp
    import util

    iW_mesh = MeshImFreq(beta, 'Boson', n_iw)
    iw_mesh = MeshImFreq(beta, 'Fermion', n_iw)
    chi3_mesh = MeshProduct(iW_mesh, iw_mesh)

    # Convert NFFT data to DLR2D coefficient representation (evaluable at arbitrary frequencies)
    chi3pp_dlr2d = {bl: make_gf_dlr2d(S.chi3pp_iw_nfft[bl]) for bl in S.chi3pp_iw_nfft.indices}
    chi3ph_dlr2d = {bl: make_gf_dlr2d(S.chi3ph_iw_nfft[bl]) for bl in S.chi3ph_iw_nfft.indices}

    # Create target containers on (Boson, Fermion) mesh
    chi3pp = util.Block2Gf_from_struct(mesh=chi3_mesh, struct=gf_struct)
    chi3ph = util.Block2Gf_from_struct(mesh=chi3_mesh, struct=gf_struct)

    # Evaluate DLR2D at fermionic pairs using channel translations:
    #   PP: chi3(Omega, nu) at (nu1, nu2) = (nu, Omega - nu)
    #   PH: chi3(Omega, nu) at (nu1, nu2) = (nu, Omega + nu)
    for iW, iw in chi3_mesh:
        Omega, nu = iW.value, iw.value
        ferm_pp = (nu, Omega - nu)
        ferm_ph = (nu, Omega + nu)
        for bl in chi3pp.indices:
            chi3pp[bl][iW, iw] = chi3pp_dlr2d[bl](ferm_pp)
            chi3ph[bl][iW, iw] = chi3ph_dlr2d[bl](ferm_ph)

    chi3_d, chi3_m = to_physical_channels_ph(chi3ph[('up', 'up')], chi3ph[('up', 'dn')])
    # PP channels: ctint provides AABB only. For density-contracted chi3,
    # chi3_udc[a,b,c] = -chi3_ud[a,c,b] (anticommutation + ABBA→AABB index map).
    import numpy as np
    chi3_ud = util.contract_chi3_density(chi3pp[('up', 'dn')])
    chi3_udc = chi3_ud.copy()
    chi3_udc.data[...] = -np.swapaxes(chi3_ud.data, -1, -2)
    chi3_s, chi3_t = to_physical_channels_pp(chi3_ud, chi3_udc)
    obs.update(chi3_d=util.contract_chi3_density(chi3_d),
               chi3_m=util.contract_chi3_density(chi3_m),
               chi3_s=chi3_s, chi3_t=chi3_t)

    # Also store DLR2D compressed representations
    obs['chi3pp_iw_nfft'] = S.chi3pp_iw_nfft
    obs['chi3ph_iw_nfft'] = S.chi3ph_iw_nfft

# --------- Save ----------
save_results("../results/ctint.h5", "triqs_ctint", version.version,
             version.triqs_ctint_hash,
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, **obs)
