#!/usr/bin/env python

import sys, os
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import *
from save_utils import save_results, parse_measure_args

try:
    from nrgljubljana_interface import Solver, MeshReFreqPts, version
except ImportError:
    print("ERROR: nrgljubljana_interface is not installed.")
    print("Install it from https://github.com/TRIQS/nrgljubljana_interface")
    sys.exit(1)

from triqs.utility import mpi

# --------- Parse arguments ----------
SUPPORTED = []
args = parse_measure_args(SUPPORTED)

# --------- Check model compatibility ----------
if 'w_mesh' not in dir():
    print("ERROR: model.py does not define w_mesh (MeshReFreq). Required for NRG.")
    sys.exit(1)

# --------- Construct the NRG solver ----------
constr_params = {
        'beta' : beta,
        'gf_struct' : gf_struct,
        'n_iw' : n_iw,
        }
S = Solver(**constr_params)

# --------- Initialize G0_iw ----------
S.G0_iw << G0_iw

# --------- Solve! ----------
import time
solve_params = {
        'h_int' : h_int,
        'model' : 'SIAM',  # default for single-impurity models
        }

start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

# --------- Collect observables ----------
obs = {}

# Real-frequency Green function
if hasattr(S, 'G_w'):
    obs['G_w'] = S.G_w
    # Spectral function A(w) = -1/pi * Im G^R(w)
    # (can be derived in notebook, but store for convenience)

# Matsubara Green function (if available)
if hasattr(S, 'G_iw'):
    obs['G'] = S.G_iw

# Static observables
if hasattr(S, 'expv'):
    density = {}
    for bl, bl_size in gf_struct:
        for i in range(bl_size):
            key = f"{bl}_{i}" if bl_size > 1 else bl
            # NRG expv keys depend on the model template
            nkey = f"n_d_{bl}" if bl_size == 1 else f"n_d_{bl}_{i}"
            if nkey in S.expv:
                density[key] = S.expv[nkey]
    if density:
        obs['static_obs'] = {'density': density}

# --------- Save ----------
save_results("../results/nrg.h5", "nrgljubljana", version.version,
             version.nrgljubljana_interface_hash,
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, **obs)
