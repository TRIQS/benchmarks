#!/usr/bin/env python

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import *
from save_utils import save_results, parse_measure_args

import numpy as np
from numpy import linalg

from triqs.gf import fit_hermitian_tail, Fourier, make_zero_tail
from triqs.utility import mpi
from triqs_ctseg import Solver, version

# --------- Parse arguments ----------
SUPPORTED = []
args = parse_measure_args(SUPPORTED)

# --------- Construct the CTSEG solver ----------
constr_params = {
        'beta' : beta,
        'gf_struct' : gf_struct,
        'n_tau' : 10001
        }
S = Solver(**constr_params)

# --- We need to rotate G0_iw into the local eigenbasis
def get_h0_Delta(G_iw):
    """
    This function extracts the h_0 as well as Delta(iw) component
    for a BlockGf G_iw of the form 1/(iw - h_0 - Delta(iw))
    """
    assert isinstance(G_iw, BlockGf)
    h0_lst, Delta_iw = [], G_iw.copy()
    for bl in G_iw.indices:
        Delta_iw[bl] << iOmega_n - inverse(G_iw[bl])
        tail, err = fit_hermitian_tail(Delta_iw[bl])
        Delta_iw[bl] << Delta_iw[bl] - tail[0]
        h0_lst.append(tail[0])
    return h0_lst, Delta_iw

# Get the rotations to the eigenbasis for each block of G0_iw
h0, Delta_iw = get_h0_Delta(G0_iw)
rot_lst = [np.matrix(linalg.eig(h0_bl)[1]) for h0_bl in h0]
# Compute chemical potential

h0_bl = {}
for i, s in enumerate(block_names):
    h0_bl[s] = np.diag(linalg.eig(h0[i])[0].real)

h_loc0 = sum(c_dag_vec[s] * h0_bl[s] * c_vec[s] for s in block_names)[0,0]

# Rotate Delta_iw
for (bl, g0_bl), rot_bl in zip(Delta_iw, rot_lst):
    g0_bl << rot_bl.H * g0_bl * rot_bl

# --------- Initialize G0_iw ----------
S.Delta_tau << Fourier(Delta_iw)
S.Delta_tau << S.Delta_tau.real

# --------- Solve! ----------
solve_params = {
        'h_int' : h_int,
        'n_warmup_cycles' : 10000,
        'n_cycles' : 1000000,
        'length_cycle' : 100,
        "h_loc0": h_loc0,
        "measure_densities": True,
        }
start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

# Rotate back G_tau
for (bl, g_bl), rot_bl in zip(S.results.G_tau, rot_lst):
    g_bl << rot_bl * g_bl * rot_bl.H

# --------- Collect observables ----------
G_iw = BlockGf(mesh=iw_mesh, gf_struct=gf_struct)
for bl, l in gf_struct:
    tail = make_zero_tail(G_iw[bl], 2)
    tail[1] = np.eye(l)
    G_iw[bl] << Fourier(S.results.G_tau[bl], tail)

obs = {'G': G_iw}

# Static observables
density = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = S.results.densities[bl][i]
obs['static_obs'] = {'density': density}

# --------- Save ----------
save_results("../results/ctseg.h5", "triqs_ctseg", version.version,
             version.triqs_ctseg_hash,
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, **obs)
