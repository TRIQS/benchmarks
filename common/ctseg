#!/usr/bin/env python
# Solver: CT-HYB-SEG (triqs_ctseg) -- segment picture
# Requires: non-zero Delta(iw), density-density h_int, diagonal h_0
# Auto-detects D0_func, Jperp_func

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import beta, gf_struct, block_names, G0_iw, c_dag_vec, c_vec, h_int, n_iw
from save_utils import save_results, parse_measure_args

import numpy as np
from numpy import linalg

from triqs.gf import BlockGf, Gf, GfImFreq, GfImTime, MeshImFreq, fit_hermitian_tail, Fourier, iOmega_n, inverse, make_zero_tail
from triqs.utility import mpi
from triqs_ctseg import Solver, version

# --------- Parse arguments ----------
SUPPORTED = ['chi2']
args = parse_measure_args(SUPPORTED)

# --------- Auto-detect dynamic interactions from model.py ----------
try:
    from model import D0_func, D0_block_pairs
    has_D0 = True
except ImportError:
    has_D0 = False
try:
    from model import Jperp_func
    has_Jperp = True
except ImportError:
    has_Jperp = False

n_tau_bosonic = 2001

# --------- Construct the CTSEG solver ----------
constr_params = {
        'beta' : beta,
        'gf_struct' : gf_struct,
        'n_tau' : 10001
        }

if has_D0 or has_Jperp:
    constr_params['n_tau_bosonic'] = n_tau_bosonic

S = Solver(**constr_params)

# --- We need to rotate G0_iw into the local eigenbasis
def get_h0_Delta(G_iw):
    """
    This function extracts the h_0 as well as Delta(iw) component
    for a BlockGf G_iw of the form 1/(iw - h_0 - Delta(iw))
    """
    assert isinstance(G_iw, BlockGf)
    h0_lst, Delta_iw = [], G_iw.copy()
    for bl in G_iw.indices:
        Delta_iw[bl] << iOmega_n - inverse(G_iw[bl])
        tail, err = fit_hermitian_tail(Delta_iw[bl])
        Delta_iw[bl] << Delta_iw[bl] - tail[0]
        h0_lst.append(tail[0])
    return h0_lst, Delta_iw

# Get the rotations to the eigenbasis for each block of G0_iw
h0, Delta_iw = get_h0_Delta(G0_iw)
rot_lst = [np.matrix(linalg.eig(h0_bl)[1]) for h0_bl in h0]
# Compute chemical potential

h0_bl = {}
for i, s in enumerate(block_names):
    h0_bl[s] = np.diag(linalg.eig(h0[i])[0].real)

h_loc0 = sum(c_dag_vec[s] * h0_bl[s] * c_vec[s] for s in block_names)[0,0]

# Rotate Delta_iw
for (bl, g0_bl), rot_bl in zip(Delta_iw, rot_lst):
    g0_bl << rot_bl.H * g0_bl * rot_bl

# --------- Initialize Delta_tau ----------
S.Delta_tau << Fourier(Delta_iw)
S.Delta_tau << S.Delta_tau.real

# --------- Fill dynamic interactions ----------
if has_D0:
    d0_iw = GfImFreq(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic // 2)
    d0_iw << D0_func
    d0_tau = GfImTime(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic)
    d0_tau << Fourier(d0_iw)
    for b1, b2 in D0_block_pairs:
        S.D0_tau[b1, b2] << d0_tau

if has_Jperp:
    jperp_iw = GfImFreq(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic // 2)
    jperp_iw << Jperp_func
    jperp_tau = GfImTime(indices=[0], beta=beta, statistic="Boson", n_points=n_tau_bosonic)
    jperp_tau << Fourier(jperp_iw)
    S.Jperp_tau << jperp_tau

# --------- Solve! ----------
solve_params = {
        'h_int' : h_int,
        'n_warmup_cycles' : 10000,
        'n_cycles' : args.n_cycles,
        'length_cycle' : 100,
        "h_loc0": h_loc0,
        "measure_densities": True,
        }

if 'chi2' in args.measure:
    solve_params['measure_nn_tau'] = True
    solve_params['measure_Sperp_tau'] = True

start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

# Rotate back G_tau
for (bl, g_bl), rot_bl in zip(S.results.G_tau, rot_lst):
    g_bl << rot_bl * g_bl * rot_bl.H

# --------- Collect observables ----------
G_iw = BlockGf(mesh=MeshImFreq(beta, 'Fermion', n_iw), gf_struct=gf_struct)
for bl, l in gf_struct:
    tail = make_zero_tail(G_iw[bl], 2)
    tail[1] = np.eye(l)
    G_iw[bl] << Fourier(S.results.G_tau[bl], tail)

obs = {'G': G_iw}

# Static observables
density = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = S.results.densities[bl][i]
obs['static_obs'] = {'density': density}

# chi2 measurement (density-density correlator)
if 'chi2' in args.measure:
    from channels import to_physical_channels_ph

    # Fourier transform nn_tau blocks to Matsubara
    nn_tau = S.results.nn_tau
    iW_mesh = MeshImFreq(beta, 'Boson', n_iw)
    nn_iw_blocks = {}
    for bl, nn_bl in nn_tau:
        nn_iw_bl = Gf(mesh=iW_mesh, target_shape=nn_bl.target_shape)
        nn_iw_bl << Fourier(nn_bl)
        nn_iw_blocks[bl] = nn_iw_bl

    chi2_d, chi2_m = to_physical_channels_ph(nn_iw_blocks[('up', 'up')],
                                              nn_iw_blocks[('up', 'dn')])
    obs['chi2_d'] = chi2_d
    obs['chi2_m'] = chi2_m

# --------- Save ----------
save_results("../results/ctseg.h5", "triqs_ctseg", version.version,
             version.triqs_ctseg_hash,
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, **obs)
