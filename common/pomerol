#!/usr/bin/env python
# Solver: pomerol (pomerol2triqs) -- exact diagonalization
# Requires: h_tot; optional w_mesh/broadening for G(w)

import sys, os
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import h_tot, gf_struct, beta, n_iw
try:
    from model import w_mesh, w_window, n_w, broadening
except ImportError:
    w_mesh = None
import util
from save_utils import save_results, parse_measure_args

from pomerol2triqs import PomerolED

# --------- Parse arguments ----------
SUPPORTED = ['G_w', 'chi2', 'chi3', 'chi4']
args = parse_measure_args(SUPPORTED)

# --------- Construct the ED solver ----------
get_idx_tpl = lambda x: tuple(next(iter(x))[0][0][1])
op_indices = list(map(get_idx_tpl, util.get_fundamental_operators(h_tot)))

index_converter = {}

for spin, orb in op_indices:
    # Bath degrees of freedom
    if isinstance(orb, str) and 'b_' in orb:
        index_converter[(spin, orb)] = ("bath", int(orb.split('_')[1]), "up" if spin == "up" else "down")
    # Local degrees of freedom
    else:
        index_converter[(spin, orb)] = ("loc", orb, "up" if spin == "up" else "down")

ed = PomerolED(index_converter, verbose = True)

# --------- Calculate the single-particle Green function ----------
ed.diagonalize(h_tot)
G_iw = ed.G_iw([(bl, idx_lst) for bl, idx_lst in gf_struct], beta, n_iw)

# --------- Collect observables ----------
obs = {'G': G_iw}

# Static observables via ensemble_average (takes index tuples, not operators)
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = ed.ensemble_average((bl, i), (bl, i), beta)
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = ed.ensemble_average(
                    (bl, i), (bl2, j), (bl2, j), (bl, i), beta)
obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# Real-frequency Green function (--measure G_w)
if 'G_w' in args.measure:
    if w_mesh is None:
        print("ERROR: model.py does not define w_mesh. Cannot compute G_w.")
        sys.exit(1)
    obs['G_w'] = ed.G_w([(bl, idx_lst) for bl, idx_lst in gf_struct],
                        beta, w_window, n_w, broadening)

# chi2 measurement (--measure chi2)
if 'chi2' in args.measure:
    from itertools import product as iprod
    from triqs.gf import Gf, MeshImFreq
    from channels import to_physical_channels_ph, to_physical_channels_pp
    import util

    iW_mesh = MeshImFreq(beta, 'Boson', n_iw)

    # Build chi2 Block2Gf containers with target_shape=(bl1_size, bl2_size)
    # chi2_ph[(s1,s2)][a,b] = <n_{s1,a}(Omega) n_{s2,b}(-Omega)>
    chi2ph_iw = util.Block2Gf_from_struct(mesh=iW_mesh, struct=gf_struct, n_legs=2)
    chi2pp_iw = util.Block2Gf_from_struct(mesh=iW_mesh, struct=gf_struct, n_legs=2)

    for (bl1, bl1_size), (bl2, bl2_size) in iprod(gf_struct, gf_struct):
        for a, b in iprod(range(bl1_size), range(bl2_size)):
            # ph: <c†_{bl1,a} c_{bl1,a} c†_{bl2,b} c_{bl2,b}> (density-density)
            g = ed.chi_iw((bl1, a), (bl1, a), (bl2, b), (bl2, b), beta, n_iw, False)
            chi2ph_iw[(bl1, bl2)].data[:, a, b] = g.data[:]
            # pp: <c†_{bl1,a} c_{bl2,b} c†_{bl1,a} c_{bl2,b}> (pair correlator)
            g = ed.chi_iw((bl1, a), (bl2, b), (bl1, a), (bl2, b), beta, n_iw, False)
            chi2pp_iw[(bl1, bl2)].data[:, a, b] = g.data[:]

    chi2_d, chi2_m = to_physical_channels_ph(chi2ph_iw[('up', 'up')], chi2ph_iw[('up', 'dn')])
    chi2_s, chi2_t = to_physical_channels_pp(chi2pp_iw[('up', 'dn')], chi2pp_iw[('dn', 'up')])
    obs.update(chi2_d=chi2_d, chi2_m=chi2_m, chi2_s=chi2_s, chi2_t=chi2_t)

n_iw_2p = n_iw

# chi3 measurement (--measure chi3)
if 'chi3' in args.measure:
    from channels import to_physical_channels_ph, to_physical_channels_pp

    chi3_params = {'gf_struct': gf_struct, 'beta': beta,
                   'n_iw': n_iw_2p, 'n_inu': n_iw_2p}

    chi3_ph = ed.chi3_iw_inu(**chi3_params, channel='PH', block_order='AABB')
    chi3_pp = ed.chi3_iw_inu(**chi3_params, channel='PP', block_order='AABB')

    chi3_d, chi3_m = to_physical_channels_ph(chi3_ph[('up', 'up')], chi3_ph[('up', 'dn')])
    chi3_s, chi3_t = to_physical_channels_pp(chi3_pp[('up', 'dn')], chi3_pp[('dn', 'up')])
    obs.update(chi3_d=util.contract_chi3_density(chi3_d),
               chi3_m=util.contract_chi3_density(chi3_m),
               chi3_s=util.contract_chi3_density(chi3_s),
               chi3_t=util.contract_chi3_density(chi3_t))

# chi4/G2 measurement (--measure chi4)
if 'chi4' in args.measure:
    from channels import to_physical_channels_ph, to_physical_channels_pp

    g2_params = {'gf_struct': gf_struct, 'beta': beta,
                 'n_iw': n_iw_2p, 'n_inu': n_iw_2p}

    G2_ph = ed.G2_iw_inu_inup(**g2_params, channel='PH', block_order='AABB')
    G2_pp = ed.G2_iw_inu_inup(**g2_params, channel='PP', block_order='AABB')

    chi4_d, chi4_m = to_physical_channels_ph(G2_ph[('up', 'up')], G2_ph[('up', 'dn')])
    chi4_s, chi4_t = to_physical_channels_pp(G2_pp[('up', 'dn')], G2_pp[('dn', 'up')])
    obs.update(chi4_d=chi4_d, chi4_m=chi4_m, chi4_s=chi4_s, chi4_t=chi4_t)

# --------- Save ----------
save_results("../results/pomerol.h5", "pomerol", "N/A", "N/A", **obs)
