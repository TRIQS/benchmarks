#!/usr/bin/env python
# Solver: edipack (edipack2triqs) -- exact diagonalization
# Requires: h_tot, n_orb, n_orb_bath; optional w_mesh for G(w)/chi2

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import gf_struct, n_orb, n_orb_bath, h_tot, beta, n_iw
try:
    from model import w_mesh, w_window, n_w, broadening
except ImportError:
    w_mesh = None
from save_utils import save_results, parse_measure_args

try:
    from edipack2triqs.solver import EDIpackSolver, LanczosParams
except ImportError:
    print("ERROR: edipack2triqs is not installed.")
    print("Install it from https://github.com/EDIpack/edipack2triqs")
    sys.exit(1)

# --------- Parse arguments ----------
SUPPORTED = ['G_w', 'chi2']
args = parse_measure_args(SUPPORTED)

# --------- Check gf_struct compatibility ----------
if len(gf_struct) < 2:
    sys.exit("edipack: edipack2triqs does not yet support single-block gf_struct. "
             "This requires a generalization of the interface.")

# --------- Build fundamental operator lists ----------
fops_imp_up  = [('up', o) for o in range(n_orb)]
fops_imp_dn  = [('dn', o) for o in range(n_orb)]
fops_bath_up = [('up', n_orb + i) for i in range(n_orb_bath)]
fops_bath_dn = [('dn', n_orb + i) for i in range(n_orb_bath)]

# --------- Construct the EDIpack solver ----------
S = EDIpackSolver(h_tot, fops_imp_up, fops_imp_dn,
                  fops_bath_up, fops_bath_dn,
                  ed_total_ud=True,
                  lanczos_params=LanczosParams(nstates_total=4**(n_orb)),
                  verbose=1)

# --------- Solve ----------
solve_params = {'beta': beta, 'n_iw': n_iw}

if 'G_w' in args.measure and w_mesh is not None:
    solve_params.update(energy_window=w_window, n_w=n_w, broadening=broadening)

if 'chi2' in args.measure:
    solve_params.update(chi_spin=True, chi_dens=True, chi_pair=True)

start = time.time()
S.solve(**solve_params)
run_time = time.time() - start

# --------- Collect observables ----------
obs = {'G': S.g_iw}

# Static observables
import numpy as np
density = {}
nn_ab = {}
for o in range(n_orb):
    # Spin-resolved density: m_z = n_up - n_dn, n_tot = n_up + n_dn
    n_tot = S.densities[o]
    m_z = S.magnetization[o, 2]
    n_up = 0.5 * (n_tot + m_z)
    n_dn = 0.5 * (n_tot - m_z)
    key_up = f"up_{o}" if n_orb > 1 else "up"
    key_dn = f"dn_{o}" if n_orb > 1 else "dn"
    density[key_up] = n_up
    density[key_dn] = n_dn

    # nn_ab: double occupancy <n_up n_dn> per orbital
    nn_ab[f"{key_up},{key_dn}"] = S.double_occ[o]
    nn_ab[f"{key_dn},{key_up}"] = S.double_occ[o]
    nn_ab[f"{key_up},{key_up}"] = n_up  # <n_up^2> = <n_up> for single site
    nn_ab[f"{key_dn},{key_dn}"] = n_dn

obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# Real-frequency Green function (--measure G_w)
if 'G_w' in args.measure and w_mesh is not None:
    obs['G_w'] = S.g_w

# chi2 measurement (--measure chi2)
if 'chi2' in args.measure:
    from triqs.gf import Gf
    # EDIpack convention (summed over all spin sectors):
    #   chi_dens = chi_uu + chi_ud + chi_du + chi_dd     (total density susceptibility)
    #   chi_spin = (chi_uu - chi_ud - chi_du + chi_dd)/4  (Sz-Sz susceptibility)
    # Benchmark convention (channels.py, one spin row):
    #   chi2_d = chi_uu + chi_ud    chi2_m = chi_uu - chi_ud
    # NOTE: The conversion below assumes SU(2) symmetry (chi_uu=chi_dd, chi_ud=chi_du).
    # For models with magnetic field (broken SU(2)), these factors are approximate.
    #   chi_dens = 2*(chi_uu + chi_ud) → chi2_d = chi_dens / 2
    #   4*chi_spin = 2*(chi_uu - chi_ud) → chi2_m = 2 * chi_spin
    chi2_d = S.chi_dens_iw.copy()
    chi2_d *= 0.5
    chi2_m = S.chi_spin_iw.copy()
    chi2_m *= 2.0
    # PP channel (Eq. 37): chi2pp_{ijkl}(τ) = <c†_i(τ+) c_j(0+) c†_k(τ) c_l(0)>
    # EDIpack's chi_pair = chi2pp_ud (AABB density-contracted pairing correlator).
    # The crossed version chi2pp_udc (ABBA) = -chi2pp_ud by anticommutation of the
    # annihilation pair (c_dn c_up = -c_up c_dn), therefore:
    #   chi2_s = chi2pp_ud - chi2pp_udc = 2 * chi_pair
    #   chi2_t = chi2pp_ud + chi2pp_udc = 0
    chi2_s = S.chi_pair_iw.copy()
    chi2_s *= 2.0
    chi2_t = Gf(mesh=S.chi_pair_iw.mesh, target_shape=S.chi_pair_iw.target_shape)
    obs.update(chi2_d=chi2_d, chi2_m=chi2_m, chi2_s=chi2_s, chi2_t=chi2_t)

# --------- Save ----------
save_results("../results/edipack.h5", "edipack2triqs", "0.11.0", "N/A",
             solve_params=solve_params, run_time=run_time, **obs)
