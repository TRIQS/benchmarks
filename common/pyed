#!/usr/bin/env python
# Solver: pyed -- exact diagonalization
# Requires: h_tot (full Hamiltonian including bath)

import sys, os
from itertools import product
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import h_tot, gf_struct, G0_iw, n_iw, beta
import util
from save_utils import save_results, parse_measure_args

from triqs.operators import c, c_dag, n
from triqs.gf import MeshImTime, MeshImFreq, MeshProduct
from pyed.TriqsExactDiagonalization import TriqsExactDiagonalization

# --------- Parse arguments ----------
SUPPORTED = ['chi3']
args = parse_measure_args(SUPPORTED)

# --------- Construct the ED solver ----------
fundamental_operators = util.get_fundamental_operators(h_tot)
hilbert_dim = 2**len(fundamental_operators)

# chi3 via set_g3_tau scales as hilbert_dim^3 * n_tau^2 and becomes
# infeasible beyond ~16 states (dim=16 ≈ 40 min, dim=64 ≈ 45 h).
# For larger systems, use pomerol which implements chi3 more efficiently.
MAX_CHI3_DIM = 16
if 'chi3' in args.measure and hilbert_dim > MAX_CHI3_DIM:
    sys.exit(f"pyed: chi3 infeasible for Hilbert space dim {hilbert_dim} "
             f"(limit {MAX_CHI3_DIM}). Use pomerol instead.")

ed = TriqsExactDiagonalization(h_tot, fundamental_operators, beta)
print(f"Hilbert space dimension: {hilbert_dim}")
print("Free energy ", ed.get_free_energy())

# --------- Calculate the single-particle Green function ----------
G_iw = G0_iw.copy()

for bl, bl_size in gf_struct:
    for i, j in product(range(bl_size), range(bl_size)):
        ed.set_g2_iwn(G_iw[bl][i,j], c(bl,i), c_dag(bl,j))

# --------- Collect observables ----------
obs = {'G': G_iw}

# Static observables
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = ed.get_expectation_value(n(bl, i))
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = ed.get_expectation_value(n(bl, i) * n(bl2, j))
obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# chi3 measurement (--measure chi3)
if 'chi3' in args.measure:
    from channels import to_physical_channels_ph, to_physical_channels_pp

    n_tau_chi3 = 10 * (2 * n_iw + 1)
    # Both tau axes are fermionic (c† and c are fermionic operators).
    tau_mesh_f = MeshImTime(beta, 'Fermion', n_tau_chi3)

    chi3pp_tau = util.Block2Gf_from_struct(mesh=MeshProduct(tau_mesh_f, tau_mesh_f), struct=gf_struct)
    chi3ph_tau = chi3pp_tau.copy()

    for (bl1, bl1_size), (bl2, bl2_size) in product(gf_struct, gf_struct):
        ed.set_g3_tau(chi3pp_tau[(bl1, bl2)][0,0,0,0],
                      c_dag(bl1,0), c_dag(bl2,0), c(bl1,0) * c(bl2,0))
        chi3pp_tau[(bl1, bl2)] *= -1.0  # Operator reordering sign
        ed.set_g3_tau(chi3ph_tau[(bl1, bl2)][0,0,0,0],
                      c_dag(bl1,0), c(bl1,0), c_dag(bl2,0) * c(bl2,0))

    # 2D Fourier transform to fermionic (nu1, nu2) basis
    chi3pp_nu = util.Block2Gf_from_fourier2D(chi3pp_tau, n_iw, gf_struct)
    chi3ph_nu = util.Block2Gf_from_fourier2D(chi3ph_tau, n_iw, gf_struct)

    # Convert from fermionic (nu1, nu2) to channel parameterization (Omega, nu):
    #   PH: chi3_ph(Omega, nu) = chi3(nu1=nu, nu2=Omega+nu)  →  n2 = m + l
    #   PP: chi3_pp(Omega, nu) = chi3(nu1=nu, nu2=Omega-nu)  →  n2 = m - l - 1
    # where m = bosonic index, l = fermionic index.
    import numpy as np
    iW_mesh = MeshImFreq(beta, 'Boson', n_iw)
    iw_mesh = MeshImFreq(beta, 'Fermion', n_iw)
    chi3_mesh = MeshProduct(iW_mesh, iw_mesh)
    nu_mesh = chi3ph_nu[next(iter(chi3ph_nu.indices))].mesh[1]  # fermionic source mesh
    n_f = len(nu_mesh)
    f0 = nu_mesh.first_index()  # first fermionic integer index (-n_iw)

    chi3pp_iw = util.Block2Gf_from_struct(mesh=chi3_mesh, struct=gf_struct)
    chi3ph_iw = util.Block2Gf_from_struct(mesh=chi3_mesh, struct=gf_struct)

    for bl in chi3pp_iw.indices:
        pp_data = chi3pp_nu[bl].data
        ph_data = chi3ph_nu[bl].data
        for idx_m, iW in enumerate(iW_mesh):
            m = iW.index
            for idx_l, iw in enumerate(iw_mesh):
                l = iw.index
                # PH: chi3_ph(Omega, nu) = chi3_ferm(nu, -(Omega+nu))
                # The second operator (c) has conjugate FT, so nu2 = -(m+l)-1
                i2_ph = -(m + l) - 1 - f0
                if 0 <= i2_ph < n_f:
                    chi3ph_iw[bl].data[idx_m, idx_l] = ph_data[idx_l, i2_ph]
                # PP: chi3_pp(Omega, nu) = chi3_ferm(nu, Omega-nu)
                # Both operators are c†, so nu2 = m-l-1
                i2_pp = m - l - 1 - f0
                if 0 <= i2_pp < n_f:
                    chi3pp_iw[bl].data[idx_m, idx_l] = pp_data[idx_l, i2_pp]

    # Conjugate to match the standard convention used by ctint/pomerol.
    # The TRIQS Fourier transform uses exp(+i*w*tau) for both tau legs,
    # but the physical chi3 convention requires exp(-i*nu2*tau2) for the
    # second (annihilation) leg, resulting in an overall conjugation.
    import numpy as np
    for bl in chi3ph_iw.indices:
        chi3ph_iw[bl].data[...] = np.conj(chi3ph_iw[bl].data)
    for bl in chi3pp_iw.indices:
        chi3pp_iw[bl].data[...] = np.conj(chi3pp_iw[bl].data)

    # Contract 4-index to 3-index (density vertex diagonal) and apply spin decomposition
    chi3_d, chi3_m = to_physical_channels_ph(chi3ph_iw[('up', 'up')], chi3ph_iw[('up', 'dn')])
    chi3_ud = util.contract_chi3_density(chi3pp_iw[('up', 'dn')])
    chi3_udc = chi3_ud.copy()
    chi3_udc.data[...] = -np.swapaxes(chi3_ud.data, -1, -2)
    chi3_s, chi3_t = to_physical_channels_pp(chi3_ud, chi3_udc)
    obs.update(chi3_d=util.contract_chi3_density(chi3_d),
               chi3_m=util.contract_chi3_density(chi3_m),
               chi3_s=chi3_s, chi3_t=chi3_t)

# --------- Save ----------
save_results("../results/pyed.h5", "pyed", "N/A", "N/A", **obs)
