#!/usr/bin/env python
# Solver: pyed -- exact diagonalization
# Requires: h_tot (full Hamiltonian including bath)

import sys, os
from itertools import product
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import h_tot, gf_struct, G0_iw, n_iw, beta
import util
from save_utils import save_results, parse_measure_args

from triqs.operators import c, c_dag, n
from triqs.gf import MeshImTime, MeshProduct
from pyed.TriqsExactDiagonalization import TriqsExactDiagonalization

# --------- Parse arguments ----------
SUPPORTED = ['chi3']
args = parse_measure_args(SUPPORTED)

# --------- Construct the ED solver ----------
fundamental_operators = util.get_fundamental_operators(h_tot)
hilbert_dim = 2**len(fundamental_operators)

# chi3 via set_g3_tau scales as hilbert_dim^3 * n_tau^2 and becomes
# infeasible beyond ~16 states (dim=16 ≈ 40 min, dim=64 ≈ 45 h).
# For larger systems, use pomerol which implements chi3 more efficiently.
MAX_CHI3_DIM = 16
if 'chi3' in args.measure and hilbert_dim > MAX_CHI3_DIM:
    sys.exit(f"pyed: chi3 infeasible for Hilbert space dim {hilbert_dim} "
             f"(limit {MAX_CHI3_DIM}). Use pomerol instead.")

ed = TriqsExactDiagonalization(h_tot, fundamental_operators, beta)
print(f"Hilbert space dimension: {hilbert_dim}")
print("Free energy ", ed.get_free_energy())

# --------- Calculate the single-particle Green function ----------
G_iw = G0_iw.copy()

for bl, bl_size in gf_struct:
    for i, j in product(range(bl_size), range(bl_size)):
        ed.set_g2_iwn(G_iw[bl][i,j], c(bl,i), c_dag(bl,j))

# --------- Collect observables ----------
obs = {'G': G_iw}

# Static observables
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = ed.get_expectation_value(n(bl, i))
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = ed.get_expectation_value(n(bl, i) * n(bl2, j))
obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# chi3 measurement (--measure chi3)
if 'chi3' in args.measure:
    from channels import to_physical_channels_ph, to_physical_channels_pp

    n_tau_chi3 = 10 * (2 * n_iw + 1)
    tau_mesh = MeshImTime(beta, 'Fermion', n_tau_chi3)

    chi3pp_tau = util.Block2Gf_from_struct(mesh=MeshProduct(tau_mesh, tau_mesh), struct=gf_struct)
    chi3ph_tau = chi3pp_tau.copy()

    for (bl1, bl1_size), (bl2, bl2_size) in product(gf_struct, gf_struct):
        ed.set_g3_tau(chi3pp_tau[(bl1, bl2)][0,0,0,0],
                      c_dag(bl1,0), c_dag(bl2,0), c(bl1,0) * c(bl2,0))
        chi3pp_tau[(bl1, bl2)] *= -1.0  # Operator reordering sign
        ed.set_g3_tau(chi3ph_tau[(bl1, bl2)][0,0,0,0],
                      c_dag(bl1,0), c(bl1,0), c_dag(bl2,0) * c(bl2,0))

    chi3pp_iw = util.Block2Gf_from_fourier2D(chi3pp_tau, n_iw, gf_struct)
    chi3ph_iw = util.Block2Gf_from_fourier2D(chi3ph_tau, n_iw, gf_struct)

    chi3_d, chi3_m = to_physical_channels_ph(chi3ph_iw[('up', 'up')], chi3ph_iw[('up', 'dn')])
    chi3_s, chi3_t = to_physical_channels_pp(chi3pp_iw[('up', 'dn')], chi3pp_iw[('dn', 'up')])
    obs.update(chi3_d=chi3_d, chi3_m=chi3_m, chi3_s=chi3_s, chi3_t=chi3_t)

# --------- Save ----------
save_results("../results/pyed.h5", "pyed", "N/A", "N/A", **obs)
