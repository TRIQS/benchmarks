#!/usr/bin/env python

import sys, os
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import *
import util
from save_utils import save_results, parse_measure_args

from pyed.TriqsExactDiagonalization import TriqsExactDiagonalization

# --------- Parse arguments ----------
SUPPORTED = ['chi3', 'chi4']
args = parse_measure_args(SUPPORTED)

# --------- Construct the ED solver ----------
fundamental_operators = util.get_fundamental_operators(h_tot)
ed = TriqsExactDiagonalization(h_tot, fundamental_operators, beta)
print("Free energy ", ed.get_free_energy())

# --------- Calculate the single-particle Green function ----------
G_iw = G0_iw.copy()

for bl, bl_size in gf_struct:
    for i, j in product(range(bl_size), range(bl_size)):
        ed.set_g2_iwn(G_iw[bl][i,j], c(bl,i), c_dag(bl,j))

# --------- Collect observables ----------
obs = {'G': G_iw}

# Static observables
density = {}
nn_ab = {}
for bl, bl_size in gf_struct:
    for i in range(bl_size):
        key = f"{bl}_{i}" if bl_size > 1 else bl
        density[key] = ed.get_expectation_value(n(bl, i))
        for bl2, bl2_size in gf_struct:
            for j in range(bl2_size):
                key2 = f"{bl2}_{j}" if bl2_size > 1 else bl2
                nn_ab[f"{key},{key2}"] = ed.get_expectation_value(n(bl, i) * n(bl2, j))
obs['static_obs'] = {'density': density, 'nn_ab': nn_ab}

# chi3 measurement (--measure chi3)
if 'chi3' in args.measure:
    print("WARNING: chi3 measurement for pyed not yet implemented. "
          "Requires porting set_g3_tau + Fourier transform + spin decomposition.")

# chi4 measurement (--measure chi4)
if 'chi4' in args.measure:
    print("WARNING: chi4 measurement for pyed not yet implemented. "
          "Requires porting set_g4_tau + Fourier transform + spin decomposition.")

# --------- Save ----------
save_results("../results/pyed.h5", "pyed", "N/A", "N/A", **obs)
