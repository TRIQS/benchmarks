#!/usr/bin/env python
# Solver: ALPS CT-HYB (via DCore) -- hybridization expansion
# Requires: non-zero Delta(iw); no dynamic interactions
# Note: runs without MPI wrapper (DCore manages its own MPI subprocesses)

from dcore.tools import raise_if_mpi_imported
raise_if_mpi_imported()

from dcore.impurity_solvers.alps_cthyb import ALPSCTHYBSolver as Solver

import sys, os, time
sys.path.append(os.getcwd() + "/..")
sys.path.append(os.getcwd() + "/../../common")
from model import beta, gf_struct, n_iw, G0_iw, h_int
from dcore_util import convert_to_dcore_format, convert_to_triqs_BlockGf
from save_utils import save_results, parse_measure_args

# --------- Parse arguments ----------
SUPPORTED = []
args = parse_measure_args(SUPPORTED)

# --------- Convert model to DCore format ----------
gf_struct_dcore, u_mat, G0_iw_dcore = convert_to_dcore_format(gf_struct, h_int, G0_iw, beta, n_iw)

constr_params = {'beta': beta, 'gf_struct': gf_struct_dcore, 'n_iw': n_iw}
solve_params = {
    'timelimit': args.timelimit,
    'exec_path': 'hybmat',
    'random_seed_offset': 0,
}

# --------- Construct and run solver ----------
S = Solver(beta, gf_struct_dcore, u_mat, n_iw)
S.set_G0_iw(G0_iw_dcore)

# DCore's launch_mpi_subprocesses() calls raise_if_mpi_imported() again.
# On DLR2D, TRIQS model imports may have loaded triqs.utility.mpi as a
# side effect. Scrub it so DCore's check passes.
for _mod in list(sys.modules):
    if 'triqs.utility.mpi' in _mod or _mod == 'mpi4py':
        del sys.modules[_mod]

mpirun_command = "mpirun -np 4"
start = time.time()
S.solve(None, mpirun_command, solve_params)
run_time = time.time() - start

# --------- Collect and save ----------
G = convert_to_triqs_BlockGf(S.get_Gimp_iw(), gf_struct, beta, n_iw)
save_results("../results/alps_cthyb.h5", "alps_cthyb", "N/A", "N/A",
             constr_params=constr_params, solve_params=solve_params,
             run_time=run_time, G=G)
